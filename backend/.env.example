# ============================================================================
#  FEMS Backend — Environment configuration
#  Copy to ".env" and adjust values.   cp .env.example .env
# ============================================================================

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=12345
PGDATABASE=fems

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Service ports ---
GATEWAY_PORT=4000
AUTH_PORT=4001
EXTINGUISHER_PORT=4002
INSPECTION_PORT=4003
REPORTING_PORT=4004
NOTIFICATION_PORT=4005

# Internal base URLs (used by the gateway to proxy)
AUTH_URL=http://localhost:4001
EXTINGUISHER_URL=http://localhost:4002
INSPECTION_URL=http://localhost:4003
REPORTING_URL=http://localhost:4004
NOTIFICATION_URL=http://localhost:4005

# --- Email / OTP (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-google-app-password
MAIL_FROM=SafeGuard <your-email@example.com>
OTP_TTL_MINUTES=10

# --- Frontend origin (CORS) ---
CLIENT_ORIGIN=http://localhost:5173
